# ==============================================================================
# TradeManageSystem (TMS) — Root .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL - NEVER COMMIT REAL KEYS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
local_credentials.json
*credentials*.json

# Exceptions: Allow example files
!.env.example
!*/.env.example

# Dependencies & Build artifacts
node_modules/
*/node_modules/
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
*.tsbuildinfo

# Python
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
