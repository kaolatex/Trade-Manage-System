# ==============================================================================
# TradeManageSystem (TMS) — Python MT5 Sync Bridge Environment Variables
# ==============================================================================

# Supabase Project URL & Anon Key (From Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Sync Service Port (Default: 8000)
PORT=8000

# Background Auto-Sync Interval in Seconds (Default: 10)
SYNC_INTERVAL_SECONDS=10
