# ==============================================================================
# TradeManageSystem (TMS) — Web Frontend Environment Template
# Duplicate this file to .env.local and populate with your Supabase credentials:
# ==============================================================================

# Supabase Cloud Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Cloud Public Anon Key (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local Python MT5 Sync Bridge Service URL (runs on port 8000)
NEXT_PUBLIC_SYNC_SERVICE_URL=http://localhost:8000
